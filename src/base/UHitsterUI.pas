{* UltraStar Deluxe - Karaoke Game
 *
 * UHitsterUI: kiosk screens for the Hitster karaoke stand, drawn on top of the
 * regular USDX screens by URemoteControl.DrawOverlay.
 *
 *   waiting screen  full screen art + "Scan your card" (covers the song list)
 *   sing screen     duel bar (P1 left / P2 right), song card, lane tags
 *   score screen    full screen: song card, final duel bar, winner, countdown
 *
 * Art comes from a local directory ([Remote] ArtDir, default
 * <user dir>/hitster) generated by hitster/install.py; brand assets are not part
 * of this repository. Missing images are skipped, so the screens still work
 * (plain colours) without them.
 *
 * Layout constants are in pixels of a 1920x1080 screen and converted to the
 * 800x600 virtual canvas (stretched to 16:9) by VX / VY.
 *
 * This program is free software; you can redistribute it and/or
 * modify it under the terms of the GNU General Public License
 * as published by the Free Software Foundation; either version 2
 * of the License, or (at your option) any later version.
 *}

unit UHitsterUI;

interface

{$IFDEF FPC}
  {$MODE Delphi}
{$ENDIF}

{$I switches.inc}

uses
  UPath;

{ directory with the generated art; textures load on first use }
procedure HitsterUISetArtDir(const Dir: IPath);
{ waiting screen; Elapsed = seconds since it became visible }
procedure HitsterDrawWaiting(const Title, Sub: UTF8String; Elapsed: real);
{ sing screen overlay }
procedure HitsterDrawSing(Elapsed: real);
{ shows a line rating (0..8) next to the player's lane }
procedure HitsterLineRating(PlayerIndex, Rating: integer);
{ a scanned card has no song: "Try another card" for a few seconds }
procedure HitsterShowNotice;
{ operator warning shown at the top of the waiting screen ('' = none) }
procedure HitsterSetWarning(const Text: UTF8String);
{ score screen; Remaining < 0 hides the countdown }
procedure HitsterDrawScore(Elapsed, Remaining, Total: real);
procedure HitsterUIFree;

implementation

uses
  SysUtils,
  Math,
  SDL2,
  ULog,
  UMusic,
  UNote,
  URecord,
  URenderer,
  USong,
  UText;

const
  LOG_SOURCE = 'Hitster';

  // font families from fonts.ini written by hitster/install.py
  FAM_BROWN = 0;
  FAM_LIGHT = 1;

  CARD_NAMES: array[0..4] of string = ('coral', 'yellow', 'lime', 'lilac', 'orange');

type
  TCol = record
    R, G, B: single;
  end;

const
  C_BG:     TCol = (R: 0/255;   G: 22/255;  B: 29/255);
  C_P1:     TCol = (R: 230/255; G: 0/255;   B: 126/255);
  C_P2:     TCol = (R: 0/255;   G: 170/255; B: 213/255);
  C_P1_DIM: TCol = (R: 156/255; G: 27/255;  B: 99/255);
  C_P2_DIM: TCol = (R: 18/255;  G: 104/255; B: 128/255);
  C_YELLOW: TCol = (R: 255/255; G: 206/255; B: 68/255);
  C_WHITE:  TCol = (R: 1;       G: 1;       B: 1);
  C_INK:    TCol = (R: 22/255;  G: 16/255;  B: 15/255);   // text on cards
  C_MUTED:  TCol = (R: 169/255; G: 190/255; B: 196/255);

var
  ArtDir: IPath = nil;
  Loaded: boolean = false;

  TexWaiting, TexArrow, TexScoreBg: TTexture;
  TexPillSing, TexPillScore, TexTag1, TexTag2: TTexture;
  TexCard, TexMini: array[0..High(CARD_NAMES)] of TTexture;

  SingShare: real = 0.5;   // smoothed P1 share of the duel bar on the sing screen
  SingTicks: cardinal = 0;

  // smoothed microphone level per player (0..1)
  MicShown: array[0..1] of real = (0, 0);
  MicTicks: cardinal = 0;

  // "Try another card" notice
  NoticeTicks: cardinal = 0;
  // operator warning (e.g. song drive not connected)
  Warning: UTF8String = '';

  // last line rating per player (P1, P2)
  RatingValue: array[0..1] of integer;
  RatingTicks: array[0..1] of cardinal = (0, 0);

{ ---------------------------------------------------------------------------
  helpers
  --------------------------------------------------------------------------- }

function VX(Px: real): real; inline;
begin
  Result := Px * 800 / 1920;
end;

function VY(Px: real): real; inline;
begin
  Result := Px * 600 / 1080;
end;

function LoadArt(const Name: string): TTexture;
var
  P: IPath;
begin
  Result := nil;
  if ArtDir = nil then
    Exit;
  P := ArtDir.Append(Name);
  if not P.IsFile then
  begin
    Log.LogWarn('missing art: ' + P.ToNative, LOG_SOURCE);
    Exit;
  end;
  Result := Renderer.LoadTexture(P, TEXTURE_TYPE_TRANSPARENT, 0);
  if (Result <> nil) and Result.IsEmpty then
    FreeAndNil(Result);
end;

procedure EnsureLoaded;
var
  I: integer;
begin
  if Loaded then
    Exit;
  Loaded := true;
  TexWaiting   := LoadArt('waiting.png');
  TexArrow     := LoadArt('arrow.png');
  TexScoreBg   := LoadArt('score_bg.png');
  TexPillSing  := LoadArt('pill_sing.png');
  TexPillScore := LoadArt('pill_score.png');
  TexTag1      := LoadArt('tag_p1.png');
  TexTag2      := LoadArt('tag_p2.png');
  for I := 0 to High(CARD_NAMES) do
  begin
    TexCard[I] := LoadArt('card_' + CARD_NAMES[I] + '.png');
    TexMini[I] := LoadArt('mini_' + CARD_NAMES[I] + '.png');
  end;
  Log.LogStatus('art loaded from ' + ArtDir.ToNative, LOG_SOURCE);
end;

{ draws a texture in pixel coordinates (1920x1080); without the texture it
  falls back to a plain rectangle when Fallback is set }
procedure DrawTex(T: TTexture; X, Y, W, H: real; const C: TCol; A: real;
  TX1: real = 0; TX2: real = 1; Fallback: boolean = false);
begin
  // PrintText switches the depth test back on; without this the hidden
  // upstream screen below would cut holes into everything drawn after text
  Renderer.DepthTest := false;
  if T = nil then
  begin
    if Fallback then
      Renderer.DrawQuad(VX(X), VY(Y), 0, VX(W), VY(H), C.R, C.G, C.B, A);
    Exit;
  end;
  T.X := VX(X);
  T.Y := VY(Y);
  T.Z := 0;
  T.W := VX(W);
  T.H := VY(H);
  T.ColR := C.R;
  T.ColG := C.G;
  T.ColB := C.B;
  T.Int := 1;
  T.Alpha := A;
  T.Alpha2 := A;
  T.TexX1 := TX1;
  T.TexX2 := TX2;
  T.TexY1 := 0;
  T.TexY2 := 1;
  Renderer.DrawTexture(T);
end;

procedure Rect(X, Y, W, H: real; const C: TCol; A: real);
begin
  Renderer.DepthTest := false;
  Renderer.DrawQuad(VX(X), VY(Y), 0, VX(W), VY(H), C.R, C.G, C.B, A);
end;

procedure UseFont(Family, Style: integer; Size: real);
begin
  SetFontFamily(Family);
  SetFontStyle(Style);
  SetFontItalic(false);
  SetFontReflection(false, 0);
  SetFontSize(VY(Size));
end;

{ width of a text in pixels with the current font }
function TextPx(const S: UTF8String): real;
begin
  Result := TextWidth(S) * 1920 / 800;
end;

{ prints text; X, Y, Size in pixels. Y is the top of the em box.
  Align: 0 left, 1 centre, 2 right. MaxW > 0 shrinks the text to fit. }
procedure Txt(const S: UTF8String; X, Y, Size: real; Align: integer;
  Family, Style: integer; const C: TCol; A: real; MaxW: real = 0);
var
  W, Sz: real;
begin
  if S = '' then
    Exit;
  Sz := Size;
  UseFont(Family, Style, Sz);
  W := TextPx(S);
  if (MaxW > 0) and (W > MaxW) then
  begin
    Sz := Sz * MaxW / W;
    SetFontSize(VY(Sz));
    W := TextPx(S);
  end;
  case Align of
    1: X := X - W / 2;
    2: X := X - W;
  end;
  SetFontColor(C.R, C.G, C.B, A);
  SetFontPos(VX(X), VY(Y + (Size - Sz) / 2));
  Renderer.DepthTest := false;
  PrintText(S);
  Renderer.DepthTest := false;
end;

function FmtScore(V: integer): UTF8String;
begin
  if V < 0 then
    V := 0;
  if V >= 1000 then
    Result := IntToStr(V div 1000) + ' ' + Format('%.3d', [V mod 1000])
  else
    Result := IntToStr(V);
end;

function Mix(const A, B: TCol; T: real): TCol;
begin
  Result.R := A.R + (B.R - A.R) * T;
  Result.G := A.G + (B.G - A.G) * T;
  Result.B := A.B + (B.B - A.B) * T;
end;

function EaseOut(T: real): real;
begin
  T := EnsureRange(T, 0, 1);
  Result := 1 - Power(1 - T, 3);
end;

{ P1 share of the bar; both labels stay readable at the extremes }
function ShareOf(S1, S2: real): real;
begin
  if S1 + S2 <= 0 then
    Result := 0.5
  else
    Result := S1 / (S1 + S2);
  Result := EnsureRange(Result, 0.14, 0.86);
end;

function SongArtist: UTF8String;
begin
  if CurrentSong <> nil then Result := CurrentSong.Artist else Result := '';
end;

function SongTitle: UTF8String;
begin
  if CurrentSong <> nil then Result := CurrentSong.Title else Result := '';
end;

function SongYear: UTF8String;
begin
  Result := '';
  if (CurrentSong <> nil) and (CurrentSong.Year > 0) then
    Result := IntToStr(CurrentSong.Year);
end;

{ same song, same card colour }
function CardIndex: integer;
var
  S: UTF8String;
  I: integer;
  H: cardinal;
begin
  S := SongArtist + '|' + SongTitle;
  H := 0;
  for I := 1 to Length(S) do
    H := (H * 31 + Ord(S[I])) mod 1000003;   // stays far below overflow
  Result := H mod cardinal(Length(CARD_NAMES));
end;

function SongProgress: real;
var
  Total: real;
begin
  Result := 0;
  Total := 0;
  if LyricsState <> nil then
    Total := LyricsState.TotalTime;
  if (Total <= 0) and (AudioPlayback <> nil) then
    Total := AudioPlayback.Length;
  if (Total > 0) and (AudioPlayback <> nil) then
    Result := EnsureRange(AudioPlayback.Position / Total, 0, 1);
end;

function PlayerScore(I: integer): integer;
begin
  Result := 0;
  if (I < PlayersPlay) and (I <= High(Player)) then
    Result := Player[I].ScoreTotalInt;
end;

{ splits a title in two lines near the middle when it does not fit }
procedure SplitTitle(const S: UTF8String; MaxW: real; out L1, L2: UTF8String);
var
  I, Best: integer;
begin
  L1 := S;
  L2 := '';
  if TextPx(S) <= MaxW then
    Exit;
  Best := 0;
  for I := 1 to Length(S) do
    if (S[I] = ' ') and ((Best = 0) or (Abs(I - Length(S) div 2) < Abs(Best - Length(S) div 2))) then
      Best := I;
  if Best = 0 then
    Exit;
  L1 := Copy(S, 1, Best - 1);
  L2 := Copy(S, Best + 1, Length(S));
end;

{ duel bar: one white pill tinted pink on the left and cyan on the right }
procedure DrawDuelPill(T: TTexture; X, Y, W, H, Share: real; const CL, CR: TCol);
begin
  if T = nil then
  begin
    Rect(X, Y, W * Share, H, CL, 1);
    Rect(X + W * Share, Y, W * (1 - Share), H, CR, 1);
    Exit;
  end;
  DrawTex(T, X, Y, W * Share, H, CL, 1, 0, Share);
  DrawTex(T, X + W * Share, Y, W * (1 - Share), H, CR, 1, Share, 1);
end;

procedure HitsterSetWarning(const Text: UTF8String);
begin
  Warning := Text;
end;

procedure HitsterShowNotice;
begin
  NoticeTicks := Max(SDL_GetTicks(), 1);
end;

{ notice visibility 0..1 (fade in, hold, fade out after 4 s) and a short
  head-shake offset in pixels at its start }
function NoticeAlpha(out Shake: real): real;
const
  SHOW = 4.0;
var
  Age: real;
begin
  Result := 0;
  Shake := 0;
  if NoticeTicks = 0 then
    Exit;
  Age := (SDL_GetTicks() - NoticeTicks) / 1000;
  if (Age < 0) or (Age > SHOW) then
  begin
    NoticeTicks := 0;
    Exit;
  end;
  Result := Min(1, Age / 0.15) * EnsureRange((SHOW - Age) / 0.4, 0, 1);
  Shake := 16 * Sin(Age * 38) * Exp(-Age * 7);
end;

{ the screen's call to action, or the notice in its place }
procedure DrawCallToAction(const Title, Sub: UTF8String; TitleY, TitleSize, SubY, SubSize: real);
var
  NA, Shake: real;
begin
  NA := NoticeAlpha(Shake);
  if NA < 1 then
  begin
    Txt(Title, 960, TitleY, TitleSize, 1, FAM_BROWN, ftBoldHighRes, C_WHITE, 1 - NA, 1700);
    Txt(Sub, 960, SubY, SubSize, 1, FAM_LIGHT, ftRegular, C_MUTED, 1 - NA, 1600);
  end;
  if NA > 0 then
  begin
    Txt('Try another card', 960 + Shake, TitleY, TitleSize, 1, FAM_BROWN, ftBoldHighRes, C_YELLOW, NA, 1700);
    Txt('This song isn''t on today''s list', 960, SubY, SubSize, 1, FAM_LIGHT, ftRegular, C_WHITE, NA, 1600);
  end;
end;

procedure BeginOverlay;
begin
  Renderer.DepthTest := false;
  Renderer.SetBlend(true);
end;

procedure EndOverlay;
begin
  Renderer.DepthTest := true;
end;

{ ---------------------------------------------------------------------------
  waiting screen
  --------------------------------------------------------------------------- }

procedure HitsterDrawWaiting(const Title, Sub: UTF8String; Elapsed: real);
var
  Bob, Pulse: real;
begin
  EnsureLoaded;
  BeginOverlay;

  Rect(0, 0, 1920, 1080, C_BG, 1);
  DrawTex(TexWaiting, 0, 0, 1920, 1080, C_WHITE, 1);

  DrawCallToAction(Title, Sub, 800, 104, 948, 34);

  // for the operator: something is missing (small, top left, out of the way)
  if Warning <> '' then
  begin
    Rect(40, 40, 14, 14, C_YELLOW, 0.6 + 0.4 * Sin(Elapsed * 4));
    Txt(Warning, 68, 32, 28, 0, FAM_BROWN, ftBold, C_YELLOW, 1, 1800);
  end;

  // the arrow points down at the scanner
  Bob := Sin(Elapsed * 3.2) * 7;
  Pulse := 0.75 + 0.25 * Sin(Elapsed * 3.2);
  DrawTex(TexArrow, 960 - 18, 1012 + Bob, 36, 23, C_WHITE, Pulse);

  EndOverlay;
end;

{ ---------------------------------------------------------------------------
  sing screen
  --------------------------------------------------------------------------- }

{ rating of the last line: pops in, rises a little and fades out.
  Only encouraging ratings are shown (guests are business partners, the
  brand tone is fun and inclusive); weak lines simply show nothing.
  CenterY is the vertical middle of the text, Align as in Txt. }
procedure DrawRating(Player: integer; X, CenterY: real; Align: integer);
const
  SIZE = 46;
  SHOW = 1.6;   // seconds on screen
var
  Age, K, A, Sz: real;
  Lbl: UTF8String;
  C: TCol;
begin
  if RatingTicks[Player] = 0 then
    Exit;
  Age := (SDL_GetTicks() - RatingTicks[Player]) / 1000;
  if (Age < 0) or (Age > SHOW) then
    Exit;
  case RatingValue[Player] of
    8: begin Lbl := 'PERFECT!'; C := C_YELLOW; end;
    7: begin Lbl := 'AWESOME!'; C := C_YELLOW; end;
    6: begin Lbl := 'GREAT!';   C := C_WHITE;  end;
    5: begin Lbl := 'GOOD!';    C := C_WHITE;  end;
    4: begin Lbl := 'NOT BAD!'; C := C_MUTED;  end;
  else
    Exit;
  end;
  K := EaseOut(Age / 0.18);
  Sz := SIZE * (0.65 + 0.35 * K);
  A := Min(1, Age / 0.08) * EnsureRange((SHOW - Age) / 0.4, 0, 1);
  Txt(Lbl, X, CenterY - Sz / 2 - 14 * EaseOut(Age / SHOW), Sz, Align,
    FAM_BROWN, ftOutline, C, A);
end;

{ microphone level 0..1 from the newest capture samples (RMS, -50..-12 dB) }
function MicLevel(Player: integer): real;
var
  Sound: TCaptureBuffer;
  I: integer;
  Sum, Rms: double;
begin
  Result := 0;
  if (AudioInputProcessor = nil) or (Player > High(AudioInputProcessor.Sound)) then
    Exit;
  Sound := AudioInputProcessor.Sound[Player];
  if Sound = nil then
    Exit;
  Sum := 0;
  Sound.LockAnalysisBuffer();
  try
    for I := 0 to High(Sound.AnalysisBuffer) do
      Sum := Sum + Sqr(Sound.AnalysisBuffer[I] / 32768);
  finally
    Sound.UnlockAnalysisBuffer();
  end;
  Rms := Sqrt(Sum / Length(Sound.AnalysisBuffer));
  if Rms < 1e-5 then
    Exit;
  Result := EnsureRange((20 * Log10(Rms) + 50) / 38, 0, 1);
  // a recognised pitch means singing, not just room noise
  if Sound.ToneValid then
    Result := Max(Result, 0.45);
end;

{ "someone is singing": four bars under the player tag, driven by the mic }
procedure DrawMicMeter(Player: integer; X, Y: real; const C: TCol; Dt: real);
const
  BARS = 4;  BAR_W = 10;  GAP = 8;  MAX_H = 28;
var
  Lv, H, Wobble: real;
  I: integer;
begin
  Lv := MicLevel(Player);
  // fast attack, slower release
  if Lv > MicShown[Player] then
    MicShown[Player] := MicShown[Player] + (Lv - MicShown[Player]) * Min(1, Dt * 18)
  else
    MicShown[Player] := MicShown[Player] + (Lv - MicShown[Player]) * Min(1, Dt * 5);
  Lv := MicShown[Player];
  for I := 0 to BARS - 1 do
  begin
    Wobble := 0.6 + 0.4 * Sin(SDL_GetTicks() / 1000 * (7 + I * 2.3) + I * 1.9);
    H := 5 + (MAX_H - 5) * Lv * Wobble;
    Rect(X + I * (BAR_W + GAP), Y + MAX_H - H, BAR_W, H, C, 0.35 + 0.65 * Min(1, Lv * 2));
  end;
end;

{ x of the current beat on a note lane (pixels), or -1 outside the sung line.
  USDX lays a line's notes out linearly from x 40 to 760 (800x600 canvas):
  from the first note's start to the line's end beat (see UDraw.SingDrawLine). }
function NowX(Track: integer; out A: real): real;
var
  Beat, Len: real;
  Cur: integer;
  Line: PLine;
begin
  Result := -1;
  A := 0;
  if (CurrentSong = nil) or (LyricsState = nil) or (Track > High(CurrentSong.Tracks)) then
    Exit;
  Cur := CurrentSong.Tracks[Track].CurrentLine;
  if (Cur < 0) or (Cur >= Length(CurrentSong.Tracks[Track].Lines)) then
    Exit;
  Line := @CurrentSong.Tracks[Track].Lines[Cur];
  if Length(Line^.Notes) = 0 then
    Exit;
  Len := Line^.EndBeat - Line^.Notes[0].StartBeat;
  Beat := LyricsState.MidBeat - Line^.Notes[0].StartBeat;
  if (Len <= 0) or (Beat > Len) then
    Exit;
  // the game shows the next line before it starts: wait at its first note,
  // dimmed, as a "get ready" mark
  if Beat < 0 then
  begin
    Beat := 0;
    A := 0.35;
  end
  else
    A := 1;
  Result := (40 + 720 * Beat / Len) * 1920 / 800;
end;

{ the "now" line moving across the notes, like the playhead on the timeline }
procedure DrawNowLine(X, A, Y1, Y2: real);
begin
  if X < 0 then
    Exit;
  Rect(X - 5, Y1, 10, Y2 - Y1, C_WHITE, 0.12 * A);
  Rect(X - 1.5, Y1, 3, Y2 - Y1, C_WHITE, 0.9 * A);
end;

{ song timeline: where the lines are sung, what is behind us, where we are }
procedure DrawTimeline(X, Y, W, H: real);
var
  SongStart, SongEnd, Dur, Gap, Cur, P0, P1: real;
  T, L: integer;
  First, Last: integer;
begin
  if (CurrentSong = nil) or (LyricsState = nil) or (CurrentSong.BPM <= 0) then
    Exit;
  SongStart := CurrentSong.BPM * CurrentSong.Start / 60;
  SongEnd := CurrentSong.BPM * LyricsState.TotalTime / 60;
  Dur := SongEnd - SongStart;
  if Dur <= 0 then
    Exit;
  Gap := CurrentSong.BPM * CurrentSong.GAP / 1000 / 60;
  Cur := EnsureRange((Gap + LyricsState.MidBeat - SongStart) / Dur, 0, 1);

  Rect(X, Y, W, H, C_WHITE, 0.14);
  for T := 0 to High(CurrentSong.Tracks) do
  begin
    // duets: the second track only matters when two people sing
    if (T > 0) and (PlayersPlay < 2) then
      Break;
    for L := 0 to High(CurrentSong.Tracks[T].Lines) do
      with CurrentSong.Tracks[T].Lines[L] do
      begin
        if (Notes = nil) or (HighNote < 0) then
          Continue;
        First := Notes[0].StartBeat;
        Last := Notes[HighNote].StartBeat + Notes[HighNote].Duration;
        P0 := EnsureRange((Gap + First - SongStart) / Dur, 0, 1);
        P1 := EnsureRange((Gap + Last - SongStart) / Dur, 0, 1);
        if P1 <= P0 then
          Continue;
        if P1 <= Cur then
          Rect(X + W * P0, Y, W * (P1 - P0), H, C_YELLOW, 1)
        else if P0 >= Cur then
          Rect(X + W * P0, Y, W * (P1 - P0), H, C_WHITE, 0.5)
        else
        begin
          Rect(X + W * P0, Y, W * (Cur - P0), H, C_YELLOW, 1);
          Rect(X + W * Cur, Y, W * (P1 - Cur), H, C_WHITE, 0.5);
        end;
      end;
  end;
  // playhead
  Rect(X + W * Cur - 3, Y - 7, 6, H + 14, C_WHITE, 1);
end;

procedure HitsterDrawSing(Elapsed: real);
const
  BAR_X = 72;  BAR_Y = 34;  BAR_W = 1776;  BAR_H = 64;
  CARD_W = 600; CARD_H = 96; CARD_Y = 122;
  // USDX note lanes for two players: baselines at 250/600 and 430/600
  LANE1_Y = 450;  LANE2_Y = 774;
var
  S1, S2: integer;
  Now, Dt: cardinal;
  Target, SeamX, LabelW, X, Y, InnerX: real;
  Year, Artist, Title: UTF8String;
  Ci: integer;
  MicDt, X1, X2, A1, A2: real;
begin
  EnsureLoaded;
  BeginOverlay;

  S1 := PlayerScore(0);
  S2 := PlayerScore(1);

  // smooth the bar so it glides instead of jumping on every scored line
  Now := SDL_GetTicks();
  if (SingTicks = 0) or (Elapsed < 0.2) then
  begin
    SingShare := 0.5;
    Dt := 0;
    RatingTicks[0] := 0;
    RatingTicks[1] := 0;
  end
  else
    Dt := Now - SingTicks;
  SingTicks := Now;
  if PlayersPlay >= 2 then
    Target := ShareOf(S1, S2)
  else
    Target := 1;
  SingShare := SingShare + (Target - SingShare) * Min(1, Dt / 1000 * 3);

  // duel bar
  DrawDuelPill(TexPillSing, BAR_X, BAR_Y, BAR_W, BAR_H, SingShare, C_P1, C_P2);
  SeamX := BAR_X + BAR_W * SingShare;
  if PlayersPlay >= 2 then
  begin
    Rect(SeamX - 5, BAR_Y - 9, 10, BAR_H + 18, C_BG, 0.35);
    Rect(SeamX - 2.5, BAR_Y - 9, 5, BAR_H + 18, C_WHITE, 1);
  end;

  UseFont(FAM_BROWN, ftBold, 28);
  LabelW := TextPx('P1');
  Txt('P1', BAR_X + 32, BAR_Y + 18, 28, 0, FAM_BROWN, ftBold, C_WHITE, 0.82);
  Txt(FmtScore(S1), BAR_X + 32 + LabelW + 18, BAR_Y + 10, 44, 0, FAM_BROWN, ftBold, C_WHITE, 1);
  if PlayersPlay >= 2 then
  begin
    Txt('P2', BAR_X + BAR_W - 32, BAR_Y + 18, 28, 2, FAM_BROWN, ftBold, C_WHITE, 0.82);
    Txt(FmtScore(S2), BAR_X + BAR_W - 32 - LabelW - 18, BAR_Y + 10, 44, 2, FAM_BROWN, ftBold, C_WHITE, 1);
  end;

  // song card: year, artist, title, progress along its bottom edge
  Ci := CardIndex;
  X := 960 - CARD_W / 2;
  Y := CARD_Y;
  DrawTex(TexMini[Ci], X - CARD_W * 24 / 600, Y - CARD_H * 24 / 96,
    CARD_W * 648 / 600, CARD_H * 144 / 96, C_WHITE, 1);
  if TexMini[Ci] = nil then
    Rect(X, Y, CARD_W, CARD_H, C_YELLOW, 1);

  Year := SongYear;
  Artist := SongArtist;
  Title := SongTitle;
  InnerX := X + 30;
  if Year <> '' then
  begin
    Txt(Year, InnerX, Y + 18, 54, 0, FAM_BROWN, ftBoldHighRes, C_INK, 1);
    UseFont(FAM_BROWN, ftBoldHighRes, 54);
    InnerX := InnerX + TextPx(Year) + 24;
  end;
  Txt(Artist, InnerX, Y + 19, 26, 0, FAM_BROWN, ftBold, C_INK, 1, X + CARD_W - 26 - InnerX);
  Txt(Title, InnerX, Y + 50, 24, 0, FAM_BROWN, ftRegular, C_INK, 1, X + CARD_W - 26 - InnerX);

  // "now" line over the notes: one line through both lanes when both sing
  // the same track, a short one per lane in duets
  X1 := NowX(0, A1);
  if (PlayersPlay >= 2) and CurrentSong.isDuet then
  begin
    DrawNowLine(X1, A1, LANE1_Y - 150, LANE1_Y + 22);
    X2 := NowX(1, A2);
    DrawNowLine(X2, A2, LANE2_Y - 150, LANE2_Y + 22);
  end
  else if PlayersPlay >= 2 then
    DrawNowLine(X1, A1, LANE1_Y - 150, LANE2_Y + 22)
  else
    DrawNowLine(X1, A1, LANE1_Y - 150, LANE1_Y + 22);

  // lane tags: P1 above the upper lane on the left, P2 below the lower lane on the right
  DrawTex(TexTag1, 30, LANE1_Y - 96, 64, 40, C_WHITE, 1);
  if PlayersPlay >= 2 then
    DrawTex(TexTag2, 1920 - 30 - 64, LANE2_Y + 56, 64, 40, C_WHITE, 1);

  // microphone meters under the tags, as wide as the tag
  if MicTicks = 0 then
    MicDt := 0
  else
    MicDt := (Now - MicTicks) / 1000;
  MicTicks := Now;
  DrawMicMeter(0, 30 + 1, LANE1_Y - 48, C_P1, MicDt);
  if PlayersPlay >= 2 then
    DrawMicMeter(1, 1920 - 30 - 64 + 1, LANE2_Y + 104, C_P2, MicDt);

  // line ratings next to the tags, on each player's own side
  DrawRating(0, 30 + 64 + 18, LANE1_Y - 76, 0);
  if PlayersPlay >= 2 then
    DrawRating(1, 1920 - 30 - 64 - 18, LANE2_Y + 76, 2);

  DrawTimeline(72, 1038, 1776, 8);

  EndOverlay;
end;

procedure HitsterLineRating(PlayerIndex, Rating: integer);
begin
  if (PlayerIndex < 0) or (PlayerIndex > High(RatingValue)) then
    Exit;
  RatingValue[PlayerIndex] := Rating;
  RatingTicks[PlayerIndex] := SDL_GetTicks();
end;

{ ---------------------------------------------------------------------------
  score screen
  --------------------------------------------------------------------------- }

procedure HitsterDrawScore(Elapsed, Remaining, Total: real);
const
  CARD = 264;  CARD_Y = 70;
  BAR_X = 120; BAR_Y = 486; BAR_W = 1680; BAR_H = 180;
  REVEAL_T0 = 0.5; REVEAL_T1 = 2.2;   // seconds: scores count up in between
var
  S1, S2, Winner, Ci, I: integer;
  K, D1, D2, Share, SeamX, LabelW, WinA, X, H, Phase: real;
  CL, CR: TCol;
  A1, A2: real;
  Artist, Title, Year, L1, L2, WinText, Secs: UTF8String;
begin
  EnsureLoaded;
  BeginOverlay;

  Rect(0, 0, 1920, 1080, C_BG, 1);
  DrawTex(TexScoreBg, 0, 0, 1920, 1080, C_WHITE, 1);

  // song card (the one just sung)
  Ci := CardIndex;
  X := 960 - CARD / 2;
  DrawTex(TexCard[Ci], X - CARD * 64 / 512, CARD_Y - CARD * 64 / 512,
    CARD * 640 / 512, CARD * 640 / 512, C_WHITE, 1);
  if TexCard[Ci] = nil then
    Rect(X, CARD_Y, CARD, CARD, C_YELLOW, 1);
  Artist := SongArtist;
  Title := SongTitle;
  Year := SongYear;
  Txt(Artist, 960, CARD_Y + 30, 22, 1, FAM_BROWN, ftBold, C_INK, 1, CARD - 44);
  if Year <> '' then
    Txt(Year, 960, CARD_Y + 82, 88, 1, FAM_BROWN, ftBoldHighRes, C_INK, 1, CARD - 30);
  UseFont(FAM_BROWN, ftRegular, 20);
  SplitTitle(Title, CARD - 44, L1, L2);
  if L2 = '' then
    Txt(L1, 960, CARD_Y + CARD - 52, 20, 1, FAM_BROWN, ftRegular, C_INK, 1, CARD - 44)
  else
  begin
    Txt(L1, 960, CARD_Y + CARD - 66, 20, 1, FAM_BROWN, ftRegular, C_INK, 1, CARD - 44);
    Txt(L2, 960, CARD_Y + CARD - 42, 20, 1, FAM_BROWN, ftRegular, C_INK, 1, CARD - 44);
  end;

  // teaser: a small equalizer next to NOW PLAYING while the song excerpt plays
  UseFont(FAM_BROWN, ftBold, 22);
  X := 960 - (TextPx('NOW PLAYING') + 44) / 2;
  for I := 0 to 3 do
  begin
    Phase := Elapsed * (5.1 + I * 1.7) + I * 1.3;
    H := 6 + 16 * (0.5 + 0.5 * Sin(Phase));
    Rect(X + I * 9, 402 - H, 6, H, C_MUTED, 1);
  end;
  Txt('NOW PLAYING', X + 44, 380, 22, 0, FAM_BROWN, ftBold, C_MUTED, 1);

  // final duel: scores count up, the bar settles, then the winner is named
  S1 := PlayerScore(0);
  S2 := PlayerScore(1);
  K := EaseOut((Elapsed - REVEAL_T0) / (REVEAL_T1 - REVEAL_T0));
  D1 := S1 * K;
  D2 := S2 * K;
  if PlayersPlay >= 2 then
    Share := 0.5 + (ShareOf(S1, S2) - 0.5) * K
  else
    Share := 1;

  if PlayersPlay < 2 then Winner := 1
  else if S1 > S2 then Winner := 1
  else if S2 > S1 then Winner := 2
  else Winner := 0;
  WinA := EnsureRange((Elapsed - REVEAL_T1) / 0.4, 0, 1);

  CL := C_P1;
  CR := C_P2;
  A1 := 1;
  A2 := 1;
  if Winner = 2 then
  begin
    CL := Mix(C_P1, C_P1_DIM, WinA);
    A1 := 1 - 0.4 * WinA;
  end
  else if (Winner = 1) and (PlayersPlay >= 2) then
  begin
    CR := Mix(C_P2, C_P2_DIM, WinA);
    A2 := 1 - 0.4 * WinA;
  end;

  DrawDuelPill(TexPillScore, BAR_X, BAR_Y, BAR_W, BAR_H, Share, CL, CR);
  SeamX := BAR_X + BAR_W * Share;
  if PlayersPlay >= 2 then
  begin
    Rect(SeamX - 6, BAR_Y - 14, 12, BAR_H + 28, C_BG, 0.35);
    Rect(SeamX - 3, BAR_Y - 14, 6, BAR_H + 28, C_WHITE, 1);
  end;

  UseFont(FAM_BROWN, ftBold, 40);
  LabelW := TextPx('P1');
  Txt('P1', BAR_X + 60, BAR_Y + 70, 40, 0, FAM_BROWN, ftBold, C_WHITE, 0.82 * A1);
  Txt(FmtScore(Round(D1)), BAR_X + 60 + LabelW + 22, BAR_Y + 34, 112, 0, FAM_BROWN, ftBoldHighRes, C_WHITE, A1);
  if PlayersPlay >= 2 then
  begin
    Txt('P2', BAR_X + BAR_W - 60, BAR_Y + 70, 40, 2, FAM_BROWN, ftBold, C_WHITE, 0.82 * A2);
    Txt(FmtScore(Round(D2)), BAR_X + BAR_W - 60 - LabelW - 22, BAR_Y + 34, 112, 2, FAM_BROWN, ftBoldHighRes, C_WHITE, A2);
  end;

  // winner, under the winning side
  if WinA > 0 then
  begin
    case Winner of
      1: WinText := 'P1 WINS';
      2: WinText := 'P2 WINS';
    else
      WinText := 'DRAW';
    end;
    UseFont(FAM_BROWN, ftBold, 36);
    case Winner of
      1:
        begin
          Rect(BAR_X + 4, 718, 36, 5, C_YELLOW, WinA);
          Txt(WinText, BAR_X + 56, 700, 36, 0, FAM_BROWN, ftBold, C_YELLOW, WinA);
        end;
      2:
        begin
          Rect(BAR_X + BAR_W - 40, 718, 36, 5, C_YELLOW, WinA);
          Txt(WinText, BAR_X + BAR_W - 56, 700, 36, 2, FAM_BROWN, ftBold, C_YELLOW, WinA);
        end;
    else
      Txt(WinText, 960, 700, 36, 1, FAM_BROWN, ftBold, C_YELLOW, WinA);
    end;
  end;

  // next action
  // the notice line sits where the countdown label is, so it is only shown
  // instead of the title here (the countdown keeps running below)
  DrawCallToAction('Scan your next card', '', 812, 76, 894, 28);
  if (Remaining >= 0) and (Total > 0) then
  begin
    Rect(960 - 267, 944, 534, 7, C_WHITE, 0.14);
    Rect(960 - 267, 944, 534 * EnsureRange(Remaining / Total, 0, 1), 7, C_YELLOW, 1);
    Secs := IntToStr(Ceil(Max(Remaining, 0)));
    Txt('back to start in ' + Secs + ' s', 960, 966, 26, 1, FAM_LIGHT, ftRegular, C_MUTED, 1);
  end;

  EndOverlay;
end;

{ ---------------------------------------------------------------------------
  setup
  --------------------------------------------------------------------------- }

procedure FreeTex(var T: TTexture);
begin
  FreeAndNil(T);
end;

procedure HitsterUIFree;
var
  I: integer;
begin
  FreeTex(TexWaiting);
  FreeTex(TexArrow);
  FreeTex(TexScoreBg);
  FreeTex(TexPillSing);
  FreeTex(TexPillScore);
  FreeTex(TexTag1);
  FreeTex(TexTag2);
  for I := 0 to High(CARD_NAMES) do
  begin
    FreeTex(TexCard[I]);
    FreeTex(TexMini[I]);
  end;
  Loaded := false;
end;

procedure HitsterUISetArtDir(const Dir: IPath);
begin
  HitsterUIFree;
  ArtDir := Dir;
end;

end.
